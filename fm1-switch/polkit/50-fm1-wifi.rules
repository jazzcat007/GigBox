// Lets members of the netdev group manage the Pi's WiFi, run a password-protected hotspot and set the clock
// without sudo, so the fm1-net service (a user service) can raise the hotspot when no saved
// network connects. Without this, NetworkManager refuses from a service or an SSH session:
// `nmcli general permissions` shows wifi.share.protected "no" and the others "auth".
//
// Install once, as root:
//   sudo cp 50-fm1-wifi.rules /etc/polkit-1/rules.d/50-fm1-wifi.rules
// Remove it with: sudo rm /etc/polkit-1/rules.d/50-fm1-wifi.rules
//
// It is only these five actions (three for the WiFi, two for the clock), for one group, and it changes
// nothing else.
polkit.addRule(function (action, subject) {
    var ours = [
        "org.freedesktop.NetworkManager.settings.modify.system",
        "org.freedesktop.NetworkManager.network-control",
        "org.freedesktop.NetworkManager.wifi.share.protected",
        // setting the clock from a phone when there is no internet (docs/GUIDE-wifi-hotspot.md, The clock)
        "org.freedesktop.timedate1.set-time",
        "org.freedesktop.timedate1.set-ntp"
    ];
    if (ours.indexOf(action.id) >= 0 && subject.isInGroup("netdev")) {
        return polkit.Result.YES;
    }
});
